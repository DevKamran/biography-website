# ---- Google Gemini (single key covers both generation and embeddings) ----
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional overrides — double-check these model names are still current in
# Google AI Studio before relying on the defaults; preview model names rotate.
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2-preview

# ---- Qdrant (vector database) ----
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.your-region.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=resume_chunks

# ---- Persona ----
# The resume owner's name and role — the assistant replies in the first
# person as this person (e.g. "I worked at...") rather than "the candidate",
# and redirects off-topic questions using the role (e.g. "As a Frontend
# Developer, feel free to ask me about my skills, experience, or projects!").
RESUME_OWNER_NAME=Kamran Ali
RESUME_OWNER_ROLE=Frontend Developer

# ---- Email (used by the "send my resume to your email" chat tool) ----
# For Gmail: enable 2FA on the account, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD
# (not your normal login password). Any standard SMTP provider works too.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
