
# Base URL of the agent FastAPI service (apps/agent), used by
# /api/resume-query and /api/blog/* to proxy requests server-side.
RESUME_RAG_API_URL=https://biography-website-production.up.railway.app/

# ---- Blog admin ----
# Must match BLOG_ADMIN_TOKEN in apps/agent/.env — the frontend attaches this
# server-side when the blog admin dashboard makes write requests; the browser
# never sees it.
BLOG_ADMIN_TOKEN=your_long_random_admin_token
# Password for the /admin/blog login screen.
BLOG_ADMIN_PASSWORD=choose_a_strong_password
# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BLOG_SESSION_SECRET=your_long_random_session_secret
