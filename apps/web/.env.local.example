# LiveKit Cloud project credentials (from your LiveKit Cloud dashboard)
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Public WebSocket URL for your LiveKit project, e.g. wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Base URL of the resume-rag FastAPI service (apps/resume-rag), used by
# /api/resume-query to proxy chat questions server-side.
RESUME_RAG_API_URL=http://localhost:8000
